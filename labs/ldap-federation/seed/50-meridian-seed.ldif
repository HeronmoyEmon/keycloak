# Seed data for chapter 32's LDAP federation lab.
#
# Stands in for Meridian Trust's existing on-prem staff directory (ou=staff) -- the realistic scenario
# this chapter uses: a retail bank that already runs LDAP/AD for its employees, federating Keycloak
# against it instead of duplicating every account. Loaded automatically at container first-start by
# osixia/openldap:1.5.0's bootstrap mechanism. Base DN dc=meridiantrust,dc=example matches this compose
# file's LDAP_BASE_DN.

dn: ou=staff,dc=meridiantrust,dc=example
objectClass: organizationalUnit
ou: staff

dn: ou=groups,dc=meridiantrust,dc=example
objectClass: organizationalUnit
ou: groups

dn: uid=jmartinez,ou=staff,dc=meridiantrust,dc=example
objectClass: inetOrgPerson
objectClass: organizationalPerson
objectClass: person
uid: jmartinez
cn: Julia Martinez
sn: Martinez
givenName: Julia
mail: jmartinez@meridiantrust.example
employeeType: Teller
userPassword: TellerLdap-2026!

dn: uid=dkim,ou=staff,dc=meridiantrust,dc=example
objectClass: inetOrgPerson
objectClass: organizationalPerson
objectClass: person
uid: dkim
cn: David Kim
sn: Kim
givenName: David
mail: dkim@meridiantrust.example
employeeType: LoanOfficer
userPassword: LoanLdap-2026!

dn: uid=rpatel,ou=staff,dc=meridiantrust,dc=example
objectClass: inetOrgPerson
objectClass: organizationalPerson
objectClass: person
uid: rpatel
cn: Rhea Patel
sn: Patel
givenName: Rhea
mail: rpatel@meridiantrust.example
employeeType: FraudAnalyst
userPassword: FraudLdap-2026!

