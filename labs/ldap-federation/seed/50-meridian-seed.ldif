dn: cn=tellers,ou=groups,dc=meridiantrust,dc=example
objectClass: groupOfNames
cn: tellers
member: uid=jmartinez,ou=staff,dc=meridiantrust,dc=example

dn: cn=loan-officers,ou=groups,dc=meridiantrust,dc=example
objectClass: groupOfNames
cn: loan-officers
